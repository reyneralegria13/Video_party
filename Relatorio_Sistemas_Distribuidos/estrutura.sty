% Configuração de cores e estilo para linguagem C
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{codegreen},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\footnotesize, % Fonte tipo máquina de escrever
    breakatwhitespace=false,
    breaklines=true,                 % Quebra linhas automáticas
    captionpos=t,                    % Legenda no topo
    keepspaces=true,
    numbers=left,                    % Números na esquerda
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    language=C                       % Define a linguagem como C
}

\lstset{style=mystyle}

% --- CONFIGURAÇÃO PARA NUMERAR SEÇÕES SEM CAPÍTULOS ---
% Remove a dependência do capítulo da numeração da seção
\renewcommand{\thesection}{\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}

% Ajusta o sumário para não esperar por capítulos
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
% ---------------------------------------------------------

% ajuste para remoção de warning para apêndices e anexos
\renewcommand{\PRIVATEapendiceconfig}[2]{%
   \setboolean{abntex@apendiceousecao}{true}%
   \renewcommand{\appendixname}{#1}
   \ifthenelse{\boolean{ABNTEXsumario-abnt-6027-2012}}{
       \renewcommand{\appendixtocname}{\texorpdfstring{\MakeTextUppercase{#2}}{#2}}
   }{%
   \renewcommand{\appendixtocname}{#2}} 
   \renewcommand{\appendixpagename}{#2}
   \switchchapname{#1}% Corrected from \switchapname -> \switchchapname
   \renewcommand*{\cftappendixname}{#1 \space}
}

\newcolumntype{Y}{>{\centering\arraybackslash}X}


\definecolor{blue}{RGB}{41,5,195}

